# Option simple : coller TOUT le contenu JSON du compte de service dans cette seule variable (remplace les 3 suivantes)
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Encaissement carte (serveur uniquement)
PROCESSOR_API_KEY=
PROCESSOR_TEST_API_KEY=
PROCESSOR_WEBHOOK_SECRET=
PROCESSOR_BASE_URL=
# Bybit (cle avec droit Withdraw + IP whitelist Vercel)
BYBIT_API_KEY=
BYBIT_API_SECRET=
BYBIT_BASE_URL=https://api.bybit.com
# 32 octets en hex : openssl rand -hex 32
API_SECRET_ENC_KEY=
CRON_SECRET=
BREVO_API_KEY=
SUPPORT_EMAIL=
# Cote navigateur (publiques)
NEXT_PUBLIC_SITE_URL=https://coinvera.com
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Adresses de reception des paiements d'activation (laisser vide = crypto non proposee)
PAY_ADDR_USDT_TRC20=
PAY_ADDR_USDT_SOL=
PAY_ADDR_USDT_BEP20=
PAY_ADDR_USDT_ERC20=
PAY_ADDR_USDC_ERC20=
PAY_ADDR_TRX=
PAY_ADDR_BTC=
PAY_ADDR_ETH=
PAY_ADDR_SOL=
PAY_ADDR_BNB=
PAY_ADDR_LTC=
# Detection on-chain (facultatif : valeurs publiques par defaut) et cours des cryptos
TRONGRID_API_KEY=
RPC_ETH=
RPC_BSC=
RPC_SOL=
COINGECKO_API_KEY=

# Cartes virtuelles (CryptoInfra) — optionnel : sans clé, le module reste inactif
CRYPTOINFRA_API_KEY=
CARDS_WEBHOOK_SECRET=
# CARDS_CORE_ID=core-1
# CRYPTOINFRA_BASE_URL=https://api.cryptoinfra.build

# Carte Pro (ScarabPay) — optionnel : sans clés, le module reste inactif
SCARABPAY_KEY_ID=
SCARABPAY_SECRET=
SCARABPAY_WEBHOOK_SECRET=
# SCARABPAY_BASE_URL=https://business.scarabpay.com/api/v1

# Vérification humain (Cloudflare Turnstile) : demandée une fois à l'arrivée sur le site. Clés : dash.cloudflare.com > Turnstile > Ajouter un widget (nom d'hôte : votre domaine).
# Sans ces deux clés, le contrôle est désactivé et le site reste ouvert. HUMAN_SECRET (facultatif) signe le cookie, sinon CAPTCHA_SECRET / API_SECRET_ENC_KEY. HUMAN_GATE=off le coupe.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
HUMAN_SECRET=
HUMAN_GATE=

# Numéros virtuels (ProxNum) — optionnel : sans clé, le module reste inactif (page publique visible, achats refusés).
# Clé : proxnum.com > profil > « Gestion des clés API » > « Créer une clé API ». Serveur uniquement.
PROXNUM_API_KEY=
# PROXNUM_BASE_URL=https://proxnum.com/api/v1
# Marge Coinvera ajoutée au prix revendeur ProxNum : points de base (20000 = +200 %, soit 3 × le prix ProxNum) et montant fixe en USD.
# PROXNUM_MARKUP_BPS=20000   (0 ou valeur invalide = ignoré, la marge par défaut s'applique)
# PROXNUM_MARKUP_FLAT_USD=0

# Paiements mobile money / virement pour les cartes (FeexPay API v2) : menu Développeur de FeexPay.
# Webhook à y renseigner : https://www.coinvera.me/api/webhooks/feexpay (signature HMAC vérifiée ; le statut est toujours relu chez FeexPay avant tout crédit).
FEEXPAY_API_KEY=
FEEXPAY_SHOP_ID=
# Secret de signature du webhook (fxp_whsec_…, affiché une seule fois dans FeexPay > Webhook > mode Signature HMAC).
FEEXPAY_WEBHOOK_SECRET=
# Optionnels : FEEXPAY_BASE_URL (défaut https://api-v2.feexpay.me), FEEXPAY_STATUS_PATH (défaut /api/transactions/public/single/status/{reference})

# eSIM de voyage (eSIM Access) — optionnel : sans code d'accès, le module reste inactif (page publique visible, achats refusés).
# Code d'accès : console eSIM Access > compte > « AccessCode ». Serveur uniquement. Pas d'environnement de test : les essais se font en réel (annulez les eSIM de test pour être remboursé). Documentation : https://docs.esimaccess.com
ESIMACCESS_ACCESS_CODE=
# Clé secrète (facultatif) : si renseignée, chaque requête est en plus signée en HMAC-SHA256 (RT-Signature).
ESIMACCESS_SECRET_KEY=
# ESIMACCESS_BASE_URL=https://api.esimaccess.com/api/v1/open
# Marge Coinvera ajoutée au prix eSIM Access : points de base (3000 = +30 %, défaut) et montant fixe en USD. Prix de vente arrondi au cent supérieur.
# ESIM_MARKUP_BPS=3000   (0 ou valeur invalide = ignoré, la marge par défaut s'applique)
# ESIM_MARKUP_FLAT_USD=0
# Jeton secret (recommandé) ajouté à l'adresse du webhook : https://www.coinvera.me/api/webhooks/esim?token=<valeur>. Générer : openssl rand -hex 24
ESIM_WEBHOOK_TOKEN=
