# Option simple : coller TOUT le contenu JSON du compte de service dans cette seule variable (remplace les 3 suivantes)
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Encaissement carte (serveur uniquement)
PROCESSOR_API_KEY=
PROCESSOR_TEST_API_KEY=
PROCESSOR_WEBHOOK_SECRET=
PROCESSOR_BASE_URL=
# Bybit (cle avec droit Withdraw + IP whitelist Vercel)
BYBIT_API_KEY=
BYBIT_API_SECRET=
BYBIT_BASE_URL=https://api.bybit.com
# 32 octets en hex : openssl rand -hex 32
API_SECRET_ENC_KEY=
CRON_SECRET=
BREVO_API_KEY=
SUPPORT_EMAIL=
# Cote navigateur (publiques)
NEXT_PUBLIC_SITE_URL=https://coinvera.com
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Adresses de reception des paiements d'activation (laisser vide = crypto non proposee)
