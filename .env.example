PAY_ADDR_USDT_SOL=
PAY_ADDR_USDT_BEP20=
PAY_ADDR_USDT_ERC20=
PAY_ADDR_USDC_ERC20=
PAY_ADDR_TRX=
PAY_ADDR_BTC=
PAY_ADDR_ETH=
PAY_ADDR_SOL=
PAY_ADDR_BNB=
PAY_ADDR_LTC=
# Detection on-chain (facultatif : valeurs publiques par defaut) et cours des cryptos
TRONGRID_API_KEY=
RPC_ETH=
RPC_BSC=
RPC_SOL=
COINGECKO_API_KEY=

# Cartes virtuelles (CryptoInfra) — optionnel : sans clé, le module reste inactif
